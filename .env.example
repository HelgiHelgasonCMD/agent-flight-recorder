# Copy to .env (never commit .env). All settings are optional.

# Data directory (SQLite event store, embedded Qdrant, spool). Default: ~/.local/share/agent-flight-recorder
# AFR_HOME=

# Tenant/workspace boundary applied to every search. Default: default
# AFR_WORKSPACE=default

# metadata (default: allowlisted fields only) | sanitized_evidence (redacted, bounded excerpts)
# AFR_CAPTURE_LEVEL=metadata

# Use a Qdrant server instead of embedded mode (see compose.yaml)
# AFR_QDRANT_URL=http://localhost:6333
# AFR_INDEX_PREFIX=afr

# sentence-transformers (default) | hashing (non-semantic, tests only)
# AFR_EMBEDDING_PROVIDER=sentence-transformers
# AFR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retention for `afr purge`, and the age after which evidence is flagged stale
# AFR_RETENTION_DAYS=
# AFR_STALE_AFTER_DAYS=180

# Extra environment variable names whose values must always be redacted (comma-separated)
# AFR_REDACT_ENV=MY_INTERNAL_HOST,MY_SERVICE_URL
